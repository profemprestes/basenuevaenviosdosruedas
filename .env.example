# ==============================================================================
# ENVÍOS DOSRUEDAS — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como '.env.local' para desarrollo local o configura
# estas variables en tu proveedor de hosting / panel de AI Studio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INTEGRACIÓN CON INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI AI)
# ------------------------------------------------------------------------------
# Requerida para las funciones de asistencia y cotización inteligente mediante @google/genai.
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="TU_GEMINI_API_KEY_AQUI"

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# URL base pública de la aplicación para enlaces autorreferenciales, metadatos Open Graph y callbacks.
# En desarrollo: http://localhost:3000
# En producción: https://enviosdosruedas.com (o tu URL de despliegue)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. CONFIGURACIÓN DE CONTACTO Y WHATSAPP (OPCIONAL)
# ------------------------------------------------------------------------------
# Número de teléfono oficial de WhatsApp en formato internacional (sin '+' ni espacios)
NEXT_PUBLIC_WHATSAPP_PHONE="5492236602699"

# Email de contacto oficial para recepción de consultas
NEXT_PUBLIC_CONTACT_EMAIL="matiascejas@enviosdosruedas.com"

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE BASE DE DATOS / SUPABASE (OPCIONAL)
# ------------------------------------------------------------------------------
# Si integras persisencia de cotizaciones o seguimiento de paquetes con Supabase:
# NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-aqui"
