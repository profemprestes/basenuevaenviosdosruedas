{
  "@context": [
    "https://schema.org",
    {
      "urn": "urn:enviosdosruedas:",
      "hasComponent": {
        "@type": "@id"
      },
      "requiresAsset": {
        "@type": "@id"
      },
      "referencesComponent": {
        "@type": "@id"
      },
      "hasHandler": {
        "@type": "@id"
      },
      "visualSpecification": {
        "@type": "@json"
      }
    }
  ],
  "@graph": [
    {
      "@id": "urn:enviosdosruedas:page:home",
      "@type": "WebPage",
      "name": "Envíos DosRuedas — Mensajería Urbana y Logística MDQ",
      "url": "/",
      "filePath": "src/app/page.tsx",
      "description": "Página principal de Envíos DosRuedas con resumen de servicios, métricas locales, soluciones e-commerce y cotizador en tiempo real",
      "hasComponent": [
        "urn:enviosdosruedas:component:navbar",
        "urn:enviosdosruedas:component:hero",
        "urn:enviosdosruedas:component:metrics-bento",
        "urn:enviosdosruedas:component:ecommerce-growth",
        "urn:enviosdosruedas:component:services-carousel",
        "urn:enviosdosruedas:component:industries-showcase",
        "urn:enviosdosruedas:component:testimonials",
        "urn:enviosdosruedas:component:carrusel-redes",
        "urn:enviosdosruedas:component:contact-quote",
        "urn:enviosdosruedas:component:prefooter-and-footer",
        "urn:enviosdosruedas:component:modal:express-quote",
        "urn:enviosdosruedas:component:modal:ficha-tecnica"
      ],
      "hasHandler": [
        "urn:enviosdosruedas:handler:home:open-quote-modal",
        "urn:enviosdosruedas:handler:home:scroll-to-services"
      ]
    },
    {
      "@id": "urn:enviosdosruedas:handler:home:open-quote-modal",
      "@type": "EventHandler",
      "name": "handleOpenQuoteModal",
      "description": "Abre el modal de cotización Express fijando opcionalmente el servicio preseleccionado",
      "parameters": [
        {
          "name": "serviceId",
          "type": "string",
          "optional": true
        }
      ]
    },
    {
      "@id": "urn:enviosdosruedas:handler:home:scroll-to-services",
      "@type": "EventHandler",
      "name": "handleScrollToServices",
      "description": "Realiza scroll suave hacia la sección #servicios-carousel"
    },
    {
      "@id": "urn:enviosdosruedas:asset:moto-envios-3d",
      "@type": "ImageObject",
      "name": "Moto Envíos 3D Asset",
      "contentUrl": "/webp/moto_envios_3d_2.webp",
      "visualSpecification": {
        "composition": "Render 3D isométrico de cadete de mensajería en motocicleta con caja corporativa",
        "typography": "Anton / Outfit",
        "colorPalette": {
          "primary": "#0C59F2",
          "secondary": "#F2E40A",
          "darkAnchor": "#002273"
        },
        "sectionId": "inicio"
      }
    },
    {
      "@id": "urn:enviosdosruedas:asset:hero-mockup",
      "@type": "ImageObject",
      "name": "Hero Isometric Tracking Card",
      "contentUrl": "/images/hero-mockup.webp",
      "visualSpecification": {
        "composition": "Tarjeta azul con gráfica de rutas urbanas en directo y estados pulsantes de despacho",
        "typography": "Bebas Neue / Outfit",
        "colorPalette": {
          "primary": "#0C59F2",
          "secondary": "#F2E40A",
          "darkAnchor": "#002273"
        },
        "sectionId": "inicio"
      }
    },
    {
      "@id": "urn:enviosdosruedas:asset:local-partner-brands",
      "@type": "ImageObject",
      "name": "Logos Marcas Locales MDQ",
      "contentUrl": "/webp/logo_5.webp",
      "visualSpecification": {
        "composition": "Ticker horizontal infinito de logotipos de comercios y marcas aliadas locales",
        "typography": "N/A",
        "colorPalette": {
          "slate": "#64748b",
          "white": "#FFFFFF"
        },
        "sectionId": "ecommerce"
      }
    },
    {
      "@id": "urn:enviosdosruedas:component:hero",
      "@type": "WebUIElement",
      "name": "HeroSection",
      "filePath": "src/components/HeroSection.tsx",
      "description": "Sección héroe de 12 columnas con titular de alto impacto, pills de ventajas y mapa 3D interactivo",
      "hasHandler": [
        "urn:enviosdosruedas:handler:home:open-quote-modal",
        "urn:enviosdosruedas:handler:home:scroll-to-services"
      ],
      "requiresAsset": [
        "urn:enviosdosruedas:asset:moto-envios-3d",
        "urn:enviosdosruedas:asset:hero-mockup"
      ],
      "referencesComponent": [
        "urn:enviosdosruedas:component:atom:button",
        "urn:enviosdosruedas:component:atom:badge"
      ]
    },
    {
