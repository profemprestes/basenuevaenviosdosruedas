# .aiexclude - Files and directories excluded from AI context processing

# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Build & Output directories
.next/
out/
build/
dist/
coverage/

# Environment and Secret files
.env
.env.local
.env.production
.env.development
.env.test
*.pem
*.key
*.crt

# Version Control & IDE
.git/
.svn/
.hg/
.vscode/
.idea/

# Lock files & Cache
package-lock.json
yarn.lock
pnpm-lock.yaml
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary & OS files
.DS_Store
Thumbs.db
tmp/
temp/
