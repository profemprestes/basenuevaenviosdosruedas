      "@type": "WebUIElement",
      "name": "TestimonialsSection",
      "filePath": "src/components/TestimonialsSection.tsx",
      "description": "Módulo de reseñas verificadas de Google Maps con desgloses de 5 estrellas y testimonios de comercios MDQ",
      "referencesComponent": [
        "urn:enviosdosruedas:component:atom:card",
        "urn:enviosdosruedas:component:atom:badge"
      ]
    },
    {
